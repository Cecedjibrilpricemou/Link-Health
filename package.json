{
    "name": "baobaoheath-platform",
    "version": "1.0.0",
    "description": "BaoBaoHealth - Digital Health Platform for Guinea",
    "private": true,
    "workspaces": ["apps/api", "apps/web", "packages/shared-types"],
    "scripts": {
    "api": "npm run dev --workspace=apps/api",
    "web": "npm run start --workspace=apps/web",
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "web:lan": "npm run start:lan --workspace=apps/web",
    "dev:lan": "concurrently \"npm run api\" \"npm run web:lan\"",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run prisma:generate --workspace=apps/api && npm run build:api",
    "start": "npm run start --workspace=apps/api",
    "format": "prettier --write .",
    "backup:db": "bash scripts/backup-db.sh",
    "restore:db": "bash scripts/restore-db.sh"
  },
    "devDependencies": {
      "concurrently": "^9.1.2",
      "typescript": "^5.8.3",
      "prettier": "^3.5.3",
      "eslint": "^9.24.0"
    },
    "engines": {
      "node": ">=24.0.0",
      "npm": ">=11.0.0"
    },
    "overrides": {
      "esbuild": "^0.28.1",
      "vite": "^7.3.5",
      "undici": "^7.28.0",
      "piscina": "^5.2.0",
      "shell-quote": "^1.12.0"
    },
    "author": "BaoBaoHealth Team",
    "license": "UNLICENSED"
  }