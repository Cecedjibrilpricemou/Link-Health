NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/baobaoheath_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=VOTRE_SECRET_JWT
JWT_REFRESH_SECRET=UN_AUTRE_SECRET_DIFFERENT
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE
CLAUDE_MODEL=claude-sonnet-4-6
ORANGE_MONEY_API_KEY=VOTRE_CLE
MTN_MOMO_API_KEY=VOTRE_CLE
AWS_ACCESS_KEY_ID=VOTRE_CLE
AWS_SECRET_ACCESS_KEY=VOTRE_SECRET
AWS_S3_BUCKET=baobao-medical-docs
AWS_REGION=af-south-1
AT_API_KEY=VOTRE_CLE
AT_USERNAME=baobaoheath
ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=debug
BACKUP_ENCRYPTION_KEY=VOTRE_PASSPHRASE_DE_SAUVEGARDE
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# 32 octets en hex (64 caracteres) — generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=VOTRE_CLE_HEX_64_CARACTERES

# Limites de requetes par fenetre de 15 minutes (defaut : 300 et 20).
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=20
