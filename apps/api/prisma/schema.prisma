enum StatutCommande {
  /// L'appel est lance, aucune pharmacie n'a encore declare tout avoir.
  RECHERCHE_PHARMACIE
  /// Une pharmacie a declare detenir la totalite : elle a la commande.
  PRISE_EN_CHARGE
  /// Le panier est chiffre, ligne par ligne, aux prix de cette officine.
  /// Le patient sait ce qu'il va payer avant de payer.
  A_PAYER
  /// Les medicaments sont regles. Le transport, lui, se reglera au motard
  /// a l'arrivee : il ne passe pas par la plateforme.
  PAYEE
  /// L'officine prepare le sachet.
  EN_PREPARATION
  /// Pret, et le patient vient le chercher.
  PRETE_POUR_RETRAIT
  /// Pret, et il part en livraison. **C'est le point de jonction avec P8** :
  /// la course, l'enchere des motards et le suivi commencent ici.
  PRETE_POUR_LIVRAISON
  /// Remis au patient, ou au motard pour une livraison.
  RETIREE
  /// Dossier clos. Etat terminal.
  CLOTUREE
  /// Aucune pharmacie du quartier ne detient la totalite, ou aucune n'est
  /// partenaire. Le patient repart avec son ordonnance.
  SANS_PHARMACIE
  ANNULEE
}

enum StatutCourse {
  APPEL_OFFRES
  ATTRIBUEE
  EN_COURS
  LIVREE
  SANS_MOTARD
  ANNULEE
}

/// Mode de remise, choisi par le patient (decision du 2026-09-26). La
/// livraison n'est jamais imposee : beaucoup de patients habitent a cote d'une
/// pharmacie et iront chercher eux-memes.
enum ModeRemise {
  RETRAIT_PHARMACIE
  LIVRAISON
}

model Commande {
  id     String         @id @default(cuid())
  numero String         @unique // CM-2026-000123
  statut StatutCommande @default(RECHERCHE_PHARMACIE)

  /// Reste nul tant que le patient n'a pas choisi.
  modeRemise ModeRemise?

  /// Quartier vise par l'appel, fige a la creation : le patient peut
  /// demenager, la commande doit rester lisible telle qu'elle a ete passee.
  quartierRecherche   String?
  /// Prefecture et commune du patient au moment de l'appel, figees comme le
  /// quartier : la zone des pharmacies sollicitees (voir utils/zone.ts).
  prefectureRecherche String?
  communeRecherche    String?
  /// M1-C : premiere etape d'elargissement, vers les communes voisines du
  /// referentiel. Null tant que l'appel reste dans sa commune.
  voisinesLe          DateTime?
  /// Les voisines appelees, en minuscules, figees a cette date : un voisinage
  /// modifie ensuite ne change pas qui peut repondre a cet appel.
  communesVoisines    String[]  @default([])
  /// M5 : personne n'a repondu dans la commune, l'appel s'est etendu a toute
  /// la prefecture a cette date. Null tant qu'il reste dans la commune.
  elargieLe           DateTime?

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  idOrdonnance String     @unique
  ordonnance   Ordonnance @relation(fields: [idOrdonnance], references: [id], onDelete: Cascade)

  /// La pharmacie qui a pris la commande. Nul tant que personne n'a declare
  /// detenir la totalite â€” c'est ce champ qui porte le verrou d'attribution.
  idPharmacie     String?
  pharmacie       StructureSante? @relation("PharmacieCommande", fields: [idPharmacie], references: [id])
  priseEnChargeLe DateTime?

  /// La somme des lignes, figee au chiffrage. Elle est redondante avec
  /// `lignes`, et c'est voulu : une contrainte verifie qu'elles s'accordent,
  /// et l'ecran n'a pas a recalculer un total pour l'afficher.
  montantTotalGnf Int?

  chiffreeLe DateTime?
  preteLe    DateTime?
  remiseLe   DateTime?
  clotureeLe DateTime?

  /// Pourquoi la commande a ete annulee. Exige par contrainte des que le
  /// statut est ANNULEE : une annulation sans motif ne s'explique pas trois
  /// semaines plus tard, et c'est toujours a ce moment qu'on la cherche.
  motifAnnulation String?

  lignes   LigneCommande[]
  facture  Facture?
  reponses ReponsePharmacie[]
  courses  Course[]

  @@index([statut])
  @@index([idPharmacie])
  @@map("commandes")
}

model Course {
  id                  String       @id @default(cuid())
  numero              String       @unique
  statut              StatutCourse @default(APPEL_OFFRES)
  quartier            String
  prefecture          String
  /// La zone des motards prevenus (voir utils/zone.ts).
  commune             String?
  prixGnf             Int?
  delaiAnnonceMinutes Int?
  /// M1-C : premiere etape d'elargissement, vers les communes voisines.
  voisinesLe          DateTime?
  /// Les voisines appelees, en minuscules, figees a cette date.
  communesVoisines    String[]     @default([])
  /// M5 : aucun motard de la commune n'a fait d'offre a temps, l'appel s'est
  /// etendu a toute la prefecture a cette date.
  elargieLe           DateTime?
  creeeLe             DateTime     @default(now())
  /// R1 : debut de l'appel en cours. Egale a creeeLe, remise a l'heure d'une
  /// relance par le patient : les delais d'elargissement et le delai final
  /// se comptent depuis ici.
  ouverteLe           DateTime     @default(now())
  attribueeLe         DateTime?
  remiseLe            DateTime?
  livreeLe            DateTime?
  annuleeLe           DateTime?
  motifAnnulation     String?

  idCommande String
  commande   Commande @relation(fields: [idCommande], references: [id], onDelete: Restrict)

  idLivreur String?
  livreur   LivreurProfile? @relation(fields: [idLivreur], references: [id], onDelete: Restrict)

  offres OffreCourse[]

  @@index([prefecture, quartier, statut])
  @@index([prefecture, commune, statut])
  @@index([idLivreur, statut])
  @@map("courses")
}

model OffreCourse {
  id           String   @id @default(cuid())
  prixGnf      Int
  delaiMinutes Int
  creeeLe      DateTime @default(now())

  idCourse  String
  course    Course         @relation(fields: [idCourse], references: [id], onDelete: Cascade)
  idLivreur String
  livreur   LivreurProfile @relation(fields: [idLivreur], references: [id], onDelete: Restrict)

  @@unique([idCourse, idLivreur])
  @@index([idLivreur])
  @@map("offres_course")
}

/// Ce que chaque pharmacie sollicitee a repondu. On garde la trace meme des
/// reponses negatives : c'est ce qui permet de dire au patient Â« trois
/// pharmacies ont ete interrogees, aucune n'avait tout Â».
/// Une ligne du panier, au prix de l'officine qui a pris la commande.
///
/// **Les libelles et les prix sont figes ici, pas lus du catalogue.** Le
/// catalogue national evolue, les marges d'une officine aussi ; ce que le
/// patient a accepte de payer ce jour-la ne doit pas bouger derriere lui.
/// C'est la meme raison qui fait figer `alertes` sur une ligne d'ordonnance.
///
/// Le prix suit exactement la regle du comptoir : prix national de reference
/// plus la marge de l'officine. Deux regles de prix divergeraient en silence.
model LigneCommande {
  id String @id @default(cuid())

  /// Le libelle tel qu'il a ete montre au patient.
  libelle         String
  quantite        Int
  prixUnitaireGnf Int
  /// `quantite * prixUnitaireGnf`, figee. Une contrainte le verifie.
  montantGnf      Int

  creeLe DateTime @default(now())

  idCommande String
  commande   Commande @relation(fields: [idCommande], references: [id], onDelete: Cascade)

  /// La ligne d'ordonnance servie, pour remonter a la prescription.
  idLigneOrdonnance String
  idMedicament      String
  medicament        Medicament @relation(fields: [idMedicament], references: [id])

  @@unique([idCommande, idLigneOrdonnance])
  @@index([idCommande])
  @@map("lignes_commande")
}

model ReponsePharmacie {
  id               String    @id @default(cuid())
  aTousLesProduits Boolean
  repondueLe       DateTime  @default(now())
  /// Renseigne quand une pharmacie se retracte apres avoir pris la commande.
  retracteeLe      DateTime?

  idCommande String
  commande   Commande @relation(fields: [idCommande], references: [id], onDelete: Cascade)

  idStructure String
  structure   StructureSante @relation("ReponsesPharmacie", fields: [idStructure], references: [id])

  @@unique([idCommande, idStructure])
  @@index([idCommande])
  @@map("reponses_pharmacie")
}

// ============================================================
// Vente au comptoir (addendum du 2026-09-28, points 1.1 et 1.2)
// ============================================================

/// Une vente au comptoir d'officine.
///
/// `Facture` ne pouvait pas la porter : elle n'a aucune ligne — donc on ne
/// sait pas ce qui a ete vendu, et il n'y a rien a totaliser dans un tableau
/// de bord — elle exige un `idPatient`, alors qu'un client de passage n'a pas
/// de dossier, et elle ne porte ni vendeur, ni remise, ni etablissement.
/// Elle reste donc la note d'une consultation, et la vente vit ici.
model VenteComptoir {
  id     String      @id @default(cuid())
  numero String      @unique
  statut StatutVente @default(PAYEE)

  /// Totaux historiques figes. `remiseGnf` reste renseigne pour les anciennes
  /// ventes ; les ventes a prix fixes enregistrees depuis la migration valent 0.
  montantBrutGnf Int
  remiseGnf      Int @default(0)
  montantNetGnf  Int

  modePaiement    ModePaiement
  numeroOperateur String?

  /// Facultatif : un passant n'a pas de dossier, et l'obliger a en ouvrir un
  /// pour acheter du savon n'a pas de sens. Renseigne, il relie la vente a
  /// l'historique du patient.
  idPatient String?
  patient   PatientProfile? @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// Facultative, sauf si la vente contient un produit reglemente ou d'une
  /// categorie que les parametres soumettent a ordonnance (EF-05-12).
  idOrdonnance String?
  ordonnance   Ordonnance? @relation(fields: [idOrdonnance], references: [id], onDelete: Restrict)

  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  /// **Toute vente appartient a une session de caisse.** Le service l'exige
  /// deja ; la contrainte le rend structurel. Les deux ventes d'essai
  /// anterieures aux sessions ont ete supprimees plutot que rattachees a une
  /// session fabriquee : une session de caisse nomme un responsable, et en
  /// inventer une ferait dire au registre qu'un agent a ouvert une caisse
  /// qu'il n'a jamais ouverte.
  idSessionCaisse String
  sessionCaisse   SessionCaisse @relation(fields: [idSessionCaisse], references: [id], onDelete: Restrict)

  idVendeur String
  vendeur   Utilisateur @relation("VentesVendeur", fields: [idVendeur], references: [id], onDelete: Restrict)

  /// Tiers payant (EF-09). Sans contrat, l'assure paie tout : `montantAssureGnf`
  /// reste a 0 et `montantPatientGnf` egale le net.
  idContratAssurance  String?
  contratAssurance    ContratAssurance?  @relation(fields: [idContratAssurance], references: [id], onDelete: Restrict)
  idAdhesionAssurance String?
  adhesionAssurance   AdhesionAssurance? @relation(fields: [idAdhesionAssurance], references: [id], onDelete: Restrict)

  /// Ce que l'assureur prend, et ce que le patient paie. Les deux sont
  /// stockes : recalculer la part de l'assureur a la lecture supposerait que
  /// ni les taux ni les exclusions n'ont change depuis.
  montantAssureGnf  Int @default(0)
  montantPatientGnf Int @default(0)

  /// La pharmacie a confirme avoir compare la photo de la fiche de l'assure
  /// avec la personne au comptoir. Exige des que la fiche porte une photo.
  photoCompareeAuComptoir Boolean @default(false)

  /// L'operation de la passerelle de paiement, quand la vente passe par elle.
  ///
  /// **C'est la cle stable.** On relit le statut par elle, jamais par le
  /// numero de commande : un meme numero peut porter plusieurs operations, et
  /// la passerelle rend alors la plus recente — ce qui masquerait un paiement
  /// deja reussi si le client recommence.
  idOperation String? @unique

  /// Le lien de paiement, affiche en QR au comptoir pour que le client le
  /// scanne avec son propre telephone.
  urlPaiement String?

  /// Le dernier etat connu cote passerelle (`new`, `pending`, `success`,
  /// `canceled`, `failed`, `error`, `expired`).
  statutOperateur String?

  /// **La preuve.** La reference rendue par l'operateur une fois le paiement
  /// abouti : c'est elle qu'on oppose si quelqu'un conteste. Sans elle, un
  /// « paye en Orange Money » n'est qu'une case cochee par un agent.
  referenceTransaction String?

  annuleeLe              DateTime?
  motifAnnulation        String?
  idAnnuleePar           String?
  annuleePar             Utilisateur? @relation("VentesAnnulees", fields: [idAnnuleePar], references: [id], onDelete: SetNull)
  idAutoriseePar         String?
  annulationAutoriseePar Utilisateur? @relation("VentesAnnulationAutorisee", fields: [idAutoriseePar], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  lignes LigneVente[]

  @@index([idStructure, creeLe(sort: Desc)])
  @@index([idStructure, statut])
  @@index([idAutoriseePar])
  @@index([idAdhesionAssurance])
  @@map("ventes_comptoir")
}

/// Une session de caisse appartient a un utilisateur et a une officine.
/// Les montants de cloture sont figes pour conserver la reconciliation meme
/// si une vente est annulee ou corrigee ulterieurement.
model SessionCaisse {
  id String @id @default(cuid())

  statut                    StatutSessionCaisse @default(OUVERTE)
  montantOuvertureGnf       Int
  montantEspecesEncaisseGnf Int?
  montantOrangeMoneyGnf     Int?
  montantMtnMomoGnf         Int?
  montantTheoriqueGnf       Int?
  montantCompteGnf          Int?
  ecartGnf                  Int?
  nombreVentesPayees        Int?
  nombreVentesEnAttente     Int?
  nombreVentesAnnulees      Int?
  motifEcart                String?
  ouverteLe                 DateTime            @default(now())
  clotureeLe                DateTime?
  version                   Int                 @default(0)

  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  ventes VenteComptoir[]

  @@index([idStructure, ouverteLe(sort: Desc)])
  @@index([idUtilisateur, ouverteLe(sort: Desc)])
  @@map("sessions_caisse")
}

model LigneVente {
  id       String @id @default(cuid())
  quantite Int

  /// Prix figes au moment de la vente : prix national de reference plus la
  /// marge de l'officine. Les relire du catalogue plus tard donnerait un
  /// chiffre d'affaires qui change quand un tarif change.
  prixUnitaireGnf Int
  montantGnf      Int

  /// Les lots effectivement consommes, au format `[{ idLot, quantite }]`.
  /// Deux usages : annuler une erreur de saisie en remettant exactement ce qui
  /// est sorti, et savoir quel lot est parti chez qui en cas de rappel.
  lotsConsommes Json

  /// Le detail de la prise en charge, ligne par ligne (addendum, point 5.4).
  ///
  /// « Un reste a charge sans explication se conteste au comptoir » : le taux
  /// applique et, le cas echeant, le motif d'exclusion sont donc figes ici.
  couvert              Boolean @default(false)
  tauxAppliquePourcent Int     @default(0)
  montantAssureGnf     Int     @default(0)
  motifExclusion       String?

  idVente String
  vente   VenteComptoir @relation(fields: [idVente], references: [id], onDelete: Cascade)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id], onDelete: Restrict)

  @@index([idVente])
  @@index([idMedicament])
  @@map("lignes_vente")
}

// ============================================================
// Assurance et tiers payant (EF-09, addendum du 2026-09-28 point 5)
// ============================================================

/// Un assureur.
///
/// Rattache a une structure de type ASSURANCE quand il a des agents sur la
/// plateforme : ils se connectent alors comme tout le monde, avec les droits
/// de leur structure. Un assureur sans agents reste utilisable — ses contrats
/// sont saisis par l'administration.
model Assureur {
  id        String  @id @default(cuid())
  nom       String
  /// Code court, celui qui figure sur la carte de l'assure.
  code      String  @unique
  telephone String?
  email     String?
  estActif  Boolean @default(true)

  modeEchange ModeEchangeAssureur @default(MANUEL)

  idStructure String?         @unique
  structure   StructureSante? @relation(fields: [idStructure], references: [id], onDelete: SetNull)

  contrats           ContratAssurance[]
  contratsCollectifs ContratCollectifAssurance[]
  regles             RegleCouverture[]
  reglements         ReglementAssureur[]
  conventions        StructureAssureur[]
  personnesAssurees  PersonneAssuree[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("assureurs")
}

/// Assure les conventions d'un hopital ou d'une pharmacie independante.
/// Une pharmacie hospitaliere consomme les conventions de son parent sans
/// dupliquer ces lignes.
model StructureAssureur {
  id          String         @id @default(cuid())
  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Cascade)
  idAssureur  String
  assureur    Assureur       @relation(fields: [idAssureur], references: [id], onDelete: Cascade)
  creeLe      DateTime       @default(now())

  @@unique([idStructure, idAssureur])
  @@index([idAssureur])
  @@map("structures_assureurs")
}

/// Ce qu'un assureur a effectivement verse a une pharmacie (addendum, point 5.2).
///
/// **Sans cette table, « ce qui est paye » et « ce qui reste du » ne sont pas
/// calculables.** On sait ce que l'assureur doit — c'est la somme des parts
/// assureur des ventes — mais rien ne dit ce qu'il a regle. L'ecart entre les
/// deux est precisement ce que l'addendum demande de montrer.
///
/// Le versement couvre une periode et non des ventes nommees : c'est ainsi
/// qu'une compagnie regle une officine, par bordereau mensuel. Rattacher
/// chaque virement a des lignes de vente supposerait un rapprochement que
/// personne ne fait a la main.
model ReglementAssureur {
  id String @id @default(cuid())

  idAssureur String
  assureur   Assureur @relation(fields: [idAssureur], references: [id], onDelete: Cascade)

  /// La pharmacie reglee. `Restrict` : un versement est une trace comptable,
  /// il ne disparait pas avec la fiche de l'officine.
  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  /// En francs guineens, toujours positif. Un remboursement en sens inverse
  /// serait un autre geste, avec son propre motif.
  montantGnf Int

  /// La periode couverte. Le debut est inclus, la fin incluse : c'est ainsi
  /// qu'un bordereau se lit, « du 1er au 30 septembre ».
  periodeDebut DateTime @db.Date
  periodeFin   DateTime @db.Date

  /// Reference du virement ou du bordereau, telle que la compagnie la connait.
  reference String?

  /// Qui a saisi, pour que le chiffre ait un auteur.
  idSaisiPar String
  saisiPar   Utilisateur @relation("ReglementsAssureur", fields: [idSaisiPar], references: [id], onDelete: Restrict)

  creeLe DateTime @default(now())

  @@index([idAssureur, idStructure])
  @@index([idAssureur, periodeFin])
  @@map("reglements_assureur")
}

/// Le contrat d'un patient chez un assureur.
model ContratAssurance {
  id           String @id @default(cuid())
  /// Le numero de police, tel qu'il figure sur la carte.
  numeroPolice String
  /// Jeton opaque du QR de la carte. Genere par le service (32 octets
  /// aleatoires) : un cuid serait en partie previsible.
  jetonCarte   String @unique

  /// Taux de base, en pourcentage.
  ///
  /// **100 ne veut pas dire « tout est pris »** : il s'applique a ce qui est
  /// couvert, apres exclusions et dans la limite des plafonds. Un assure a
  /// 100 % paie quand meme son lait infantile.
  tauxBasePourcent Int @default(80)

  /// Plafond annuel de prise en charge, en GNF. 0 = pas de plafond.
  plafondAnnuelGnf Int @default(0)

  /// Franchise, en GNF : toujours a la charge du patient, deduite de la part
  /// de l'assureur.
  franchiseGnf Int @default(0)

  dateEffet DateTime
  dateFin   DateTime?

  /// Carence : jours apres la date d'effet pendant lesquels rien n'est pris.
  /// C'est ce qui empeche de s'assurer la veille d'une depense connue.
  carenceJours Int @default(0)

  /// Jours couverts apres la date de fin. 0 par defaut : la couverture
  /// s'arrete a la date de fin, sauf si le contrat prevoit une grace.
  periodeGraceJours Int @default(0)

  statut StatutContrat @default(ACTIF)

  idAssureur String
  assureur   Assureur @relation(fields: [idAssureur], references: [id], onDelete: Restrict)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  ventes               VenteComptoir[]
  controles            ControleEligibilite[]
  reglesPersonnalisees RegleCouverturePolice[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([idAssureur, numeroPolice])
  @@index([idPatient, statut])
  @@map("contrats_assurance")
}

/// Une entreprise souscriptrice d'un ou plusieurs contrats collectifs.
model EntrepriseAssuree {
  id               String   @id @default(cuid())
  raisonSociale    String
  identifiantLegal String?  @unique
  telephone        String?
  email            String?
  estActive        Boolean  @default(true)
  creeLe           DateTime @default(now())
  modifieLe        DateTime @updatedAt

  contrats ContratCollectifAssurance[]

  @@index([raisonSociale])
  @@map("entreprises_assurees")
}

/// Couverture collective souscrite par une entreprise aupres d'un assureur.
model ContratCollectifAssurance {
  id                String        @id @default(cuid())
  numeroContrat     String
  nomRegime         String
  tauxBasePourcent  Int           @default(80)
  plafondAnnuelGnf  Int           @default(0)
  franchiseGnf      Int           @default(0)
  dateEffet         DateTime
  dateFin           DateTime?
  carenceJours      Int           @default(0)
  periodeGraceJours Int           @default(0)
  statut            StatutContrat @default(ACTIF)
  creeLe            DateTime      @default(now())
  modifieLe         DateTime      @updatedAt

  idEntreprise String
  entreprise   EntrepriseAssuree @relation(fields: [idEntreprise], references: [id], onDelete: Restrict)
  idAssureur   String
  assureur     Assureur          @relation(fields: [idAssureur], references: [id], onDelete: Restrict)

  adhesions AdhesionAssurance[]
  regles    RegleCouverturePolice[]

  @@unique([idAssureur, numeroContrat])
  @@index([idEntreprise, statut])
  @@index([idAssureur, statut])
  @@map("contrats_collectifs_assurance")
}

/// La fiche d'identite d'une personne assuree, tenue par sa compagnie.
///
/// Elle reprend la piece d'identite et la photo : c'est ce qui permet a la
/// pharmacie de reconnaitre le beneficiaire au comptoir, et a la compagnie
/// d'ouvrir le tiers payant sans passage a l'accueil d'un hopital. Elle ne
/// modifie pas le dossier medical du patient : son niveau d'identite reste
/// celui que les soignants ont constate.
model PersonneAssuree {
  id                  String            @id @default(cuid())
  nom                 String
  prenoms             String
  /// 'M' ou 'F', comme le dossier patient.
  sexe                String
  dateNaissance       DateTime          @db.Date
  lieuNaissance       String
  nationalite         String
  typePiece           TypePieceIdentite
  numeroPiece         String
  dateDelivrancePiece DateTime?         @db.Date
  dateExpirationPiece DateTime?         @db.Date
  telephone           String
  adresse             String?
  /// Nom du fichier dans le stockage prive. **Jamais sous `uploads/`**, qui
  /// est servi sans authentification.
  photo               String?
  creeLe              DateTime          @default(now())
  modifieLe           DateTime          @updatedAt

  idAssureur  String
  assureur    Assureur       @relation(fields: [idAssureur], references: [id], onDelete: Restrict)
  idPatient   String
  patient     PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)
  idSaisiePar String?
  saisiePar   Utilisateur?   @relation("PersonnesAssureesSaisies", fields: [idSaisiePar], references: [id], onDelete: SetNull)

  @@unique([idAssureur, idPatient])
  @@unique([idAssureur, typePiece, numeroPiece])
  @@index([idAssureur, nom])
  @@map("personnes_assurees")
}

/// Adherence individuelle d'un beneficiaire a un contrat collectif.
model AdhesionAssurance {
  id             String        @id @default(cuid())
  numeroAdherent String
  jetonCarte     String        @unique
  dateEffet      DateTime
  /// Null : l'adhesion suit la fin du contrat collectif.
  dateFin        DateTime?
  statut         StatutContrat @default(ACTIF)
  creeLe         DateTime      @default(now())
  modifieLe      DateTime      @updatedAt

  /// Fin d'adhesion : pourquoi, quand elle a ete saisie et par qui.
  motifFin            String?
  finEnregistreeLe    DateTime?
  idFinEnregistreePar String?
  finEnregistreePar   Utilisateur? @relation("FinsAdhesion", fields: [idFinEnregistreePar], references: [id], onDelete: SetNull)

  idContratCollectif String
  contratCollectif   ContratCollectifAssurance @relation(fields: [idContratCollectif], references: [id], onDelete: Restrict)
  idPatient          String
  patient            PatientProfile            @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  ventes    VenteComptoir[]
  controles ControleEligibilite[]

  @@unique([idContratCollectif, numeroAdherent])
  @@unique([idContratCollectif, idPatient])
  @@index([idPatient, statut])
  @@map("adhesions_assurance")
}

/// Derogations de taux/exclusion propres a une police, sans modifier les
/// regles communes de l'assureur ni les autres entreprises assurees.
model RegleCouverturePolice {
  id              String           @id @default(cuid())
  categorie       CategorieProduit
  exclu           Boolean          @default(false)
  tauxPourcent    Int?
  plafondLigneGnf Int              @default(0)
  dateEffet       DateTime         @default(now())
  creeLe          DateTime         @default(now())

  idContratAssurance String?
  contratAssurance   ContratAssurance?          @relation(fields: [idContratAssurance], references: [id], onDelete: Cascade)
  idContratCollectif String?
  contratCollectif   ContratCollectifAssurance? @relation(fields: [idContratCollectif], references: [id], onDelete: Cascade)

  @@index([idContratAssurance, categorie, dateEffet])
  @@index([idContratCollectif, categorie, dateEffet])
  @@map("regles_couverture_police")
}

/// Une regle de couverture par categorie de produit.
///
/// C'est ici que vivent les exclusions citees par le chef de projet : le lait
/// infantile, les cosmetiques. Elles visent `CategorieProduit`, une
/// enumeration fermee — on ne fonde pas une regle de remboursement sur un
/// champ que chacun remplit comme il veut.
///
/// `dateEffet` permet de changer un taux sans reecrire le passe : le calcul
/// retient la regle en vigueur a la date de la vente (EF-09-03).
model RegleCouverture {
  id        String           @id @default(cuid())
  categorie CategorieProduit

  /// Exclu : rien n'est pris, quel que soit le taux du contrat.
  exclu Boolean @default(false)

  /// Taux propre a cette categorie. Null : le taux de base du contrat.
  tauxPourcent Int?

  /// Plafond par ligne de vente, en GNF. 0 = pas de plafond.
  plafondLigneGnf Int @default(0)

  dateEffet DateTime @default(now())

  idAssureur String
  assureur   Assureur @relation(fields: [idAssureur], references: [id], onDelete: Cascade)

  creeLe DateTime @default(now())

  @@index([idAssureur, categorie, dateEffet])
  @@map("regles_couverture")
}

/// Un controle d'eligibilite au comptoir (addendum, point 5.1).
///
/// La reponse est **figee** : c'est elle qui sera opposable si l'assureur
/// contente la prise en charge plus tard. On ne la recalcule donc jamais, on
/// la relit.
model ControleEligibilite {
  id String @id @default(cuid())

  eligible Boolean
  /// Pourquoi la reponse est negative, en clair : c'est ce que le comptoir
  /// explique au patient.
  motif    String?

  /// Ce qui a ete lu au moment du controle, recopie pour que la reponse reste
  /// lisible meme si le contrat change ensuite.
  numeroPolice     String?
  tauxBasePourcent Int?

  idContrat           String?
  contrat             ContratAssurance?  @relation(fields: [idContrat], references: [id], onDelete: SetNull)
  idAdhesionAssurance String?
  adhesionAssurance   AdhesionAssurance? @relation(fields: [idAdhesionAssurance], references: [id], onDelete: SetNull)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// Ou le controle a eu lieu, et qui l'a fait.
  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idControlePar String
  controlePar   Utilisateur @relation("ControlesEligibilite", fields: [idControlePar], references: [id], onDelete: Restrict)

  creeLe DateTime @default(now())

  @@index([idPatient, creeLe(sort: Desc)])
  @@index([idStructure, creeLe(sort: Desc)])
  @@index([idAdhesionAssurance])
  @@map("controles_eligibilite")
}

// Mouvement de stock immutable : ajoute seul pour tracer toute mutation de
// quantite (approvisionnement, vente, annulation, ajustement, ecriture manuelle).
enum MouvementType {
  ENTREE
  SORTIE
  AJUSTEMENT
  CORRECTION
}

model MouvementStock {
  id        String        @id @default(cuid())
  type      MouvementType
  quantite  Int
  reference String?
  motif     String?
  creeLe    DateTime      @default(now())

  idStructure   String
  structure     StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)
  idMedicament  String?
  medicament    Medicament?    @relation(fields: [idMedicament], references: [id], onDelete: Restrict)
  idStock       String?
  stock         Stock?         @relation(fields: [idStock], references: [id], onDelete: SetNull)
  idLot         String?
  lot           LotStock?      @relation(fields: [idLot], references: [id], onDelete: SetNull)
  idUtilisateur String
  utilisateur   Utilisateur    @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  @@index([idStructure, creeLe(sort: Desc)])
  @@index([idStructure, idMedicament, creeLe(sort: Desc)])
  @@index([idStructure, idUtilisateur, creeLe(sort: Desc)])
  @@index([idLot, creeLe(sort: Desc)])
  @@index([reference])
  @@map("mouvements_stock")
}

/// R15 : la correction d'un trait d'identite (sexe, date de naissance, nom,
/// prenom) par l'accueil ou l'administration, avec l'ancienne valeur.
///
/// **Une ligne par trait corrige, jamais modifiee ni supprimee.** Une erreur
/// de saisie se corrige ; elle ne s'efface pas. La date de naissance decide de
/// doses pediatriques, le sexe de normes biologiques : si une correction est
/// elle-meme fausse, il faut pouvoir dire qui l'a faite, quand, et ce qu'il y
/// avait avant.
model CorrectionIdentite {
  id             String   @id @default(cuid())
  /// prenom | nom | sexe | dateNaissance
  champ          String
  ancienneValeur String
  nouvelleValeur String
  /// Pourquoi : « erreur de saisie a l'admission, acte de naissance presente ».
  motif          String
  creeLe         DateTime @default(now())

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// `SetNull` : le depart de l'agent n'efface pas la correction.
  idAuteur String?
  auteur   Utilisateur? @relation("CorrectionsIdentite", fields: [idAuteur], references: [id], onDelete: SetNull)

  @@index([idPatient, creeLe])
  @@map("corrections_identite")
}

/// Une demande de changement de numero de telephone, en attente du code.
///
/// **Le numero est la cle du compte** : il sert a se connecter, a recevoir
/// les codes et a ouvrir le dossier par USSD. Il ne change donc qu'en deux
/// temps : le mot de passe actuel prouve que c'est le titulaire, un code
/// envoye au **nouveau** numero prouve qu'il le detient. Une session volee ne
/// suffit plus a detourner le compte vers un autre telephone.
///
/// Le code n'est jamais stocke en clair (hache comme un mot de passe).
model ChangementTelephone {
  id               String    @id @default(cuid())
  nouveauTelephone String
  codeHash         String
  expireLe         DateTime
  tentatives       Int       @default(0)
  maxTentatives    Int       @default(5)
  /// Pose a la confirmation, ou quand les tentatives sont epuisees.
  utiliseLe        DateTime?
  creeLe           DateTime  @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur, creeLe])
  @@map("changements_telephone")
}

/// R15 : ou en est une demande de correction d'identite.
enum StatutDemandeCorrection {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

/// R15 : le patient demande lui-meme la correction de son identite.
///
/// Il ne la fait pas : une identite verifiee sur piece ne se reecrit pas sur
/// simple declaration. Il la **demande**, avec sa raison, et l'accueil de sa
/// structure l'accepte - la correction passe alors par `CorrectionIdentite`,
/// avec l'ancienne valeur et l'agent - ou la refuse en disant pourquoi.
///
/// Seuls les traits demandes sont remplis ; les autres restent nuls.
model DemandeCorrectionIdentite {
  id            String                  @id @default(cuid())
  prenom        String?
  nom           String?
  sexe          String?
  /// AAAA-MM-JJ, comme sur une piece.
  dateNaissance String?
  /// Pourquoi, dans les mots du patient : « mon acte de naissance dit 2020 ».
  justification String
  statut        StatutDemandeCorrection @default(EN_ATTENTE)
  /// La reponse de l'accueil, exigee pour un refus.
  reponse       String?
  creeLe        DateTime                @default(now())
  traiteeLe     DateTime?

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// `SetNull` : le depart de l'agent n'efface pas la decision.
  idTraitePar String?
  traitePar   Utilisateur? @relation("DemandesCorrectionTraitees", fields: [idTraitePar], references: [id], onDelete: SetNull)

  @@index([statut, creeLe])
  @@index([idPatient, creeLe])
  @@map("demandes_correction_identite")
}
