/// Les pieces qu'une structure privee doit produire pour exister sur la
/// plateforme.
///
/// **On ne retient que ce que les controles exigent reellement.** La campagne
/// du 27 juillet 2026 demande l'agrement de creation, l'agrement
/// d'exploitation, les diplomes legalises du personnel de sante et les
/// attestations d'inscription aux ordres professionnels. Aucun arrete
/// d'application ne publie de liste exhaustive : inventer les autres pieces
/// aurait fabrique des obstacles que l'administration elle-meme ne pose pas.
///
/// `AUTRE` est la soupape : le jour ou une direction exige le plan
/// architectural ou la liste des equipements, la piece se depose sans
/// migration. Quand une piece devient systematique, elle gagne son type.
enum TypePieceAgrement {
  AGREMENT_CREATION
  AGREMENT_EXPLOITATION
  DIPLOME_RESPONSABLE
  INSCRIPTION_ORDRE
  /// L'assureur ne releve pas du ministere de la Sante mais de la Banque
  /// Centrale : son agrement vient d'une autre autorite, avec sa propre
  /// reference (forme D/AAAA/CAM/.../NN). Il ne se confond pas avec les deux
  /// agrements sanitaires.
  AGREMENT_ASSURANCE
  AUTRE
}

enum TypeStructure {
  POSTE
  CENTRE
  HOPITAL_PREF
  HOPITAL_REG
  CHU
  CLINIQUE
  PHARMACIE // â† NOUVEAU
  LABORATOIRE // Laboratoire d'analyses (EF-04)
  ASSURANCE // Assureur : ses agents s'y connectent comme les autres (EF-09)
}

// Partage par l'ordonnance (le document) et par ses lignes. Une ligne ne prend
// que EN_ATTENTE ou DELIVREE ; le document ajoute PARTIELLEMENT_SERVIE et
// SERVIE, calcules a partir de ses lignes. DELIVREE reste dans le type pour les
// lignes : PostgreSQL ne permet pas de retirer une valeur d'enum sans recreer
// le type.
/// Ce qu'une officine a fait d'une ligne d'ordonnance (EF-07-03/04/05).
enum TypeActeDelivrance {
  /// Le produit prescrit, en tout ou en partie.
  DELIVRE
  /// Un autre produit, avec son motif. Le prescripteur et le patient sont
  /// prevenus : une substitution muette est une modification de traitement
  /// decidee par quelqu'un qui n'a pas vu le patient.
  SUBSTITUE
  /// Rien n'a ete remis, et on dit pourquoi. Un refus muet laisse le patient
  /// repartir sans savoir s'il doit revenir ou aller ailleurs.
  REFUSE
}

enum StatutOrdonnance {
  EN_ATTENTE
  DELIVREE
  PARTIELLEMENT_SERVIE
  SERVIE
  EXPIREE
  ANNULEE
}

/// Comment la plateforme echange avec l'assureur (EF-09-02). `MANUEL` est le
/// depart : un agent valide a la main. Les deux autres attendent une
/// convention technique avec chaque assureur.
enum ModeEchangeAssureur {
  MANUEL
  PORTAIL
  API
}

enum StatutContrat {
  ACTIF
  SUSPENDU
  RESILIE
  EXPIRE
}

/// ANNULEE ne sert pas a un retour client — EF-07-11 l'interdit — mais a
/// corriger une erreur de saisie, et elle remet les lots consommes.
///
/// **`EN_ATTENTE` est arrive le 2026-10-09, et contredit ce que ce
/// commentaire affirmait** : « une vente au comptoir est payee sur place, il
/// n'y a pas d'etat en attente ». C'etait vrai tant qu'aucune passerelle
/// n'intervenait — le pharmacien cochait « Orange Money » et la vente naissait
/// payee, sans qu'un seul franc ait bouge. Un paiement mobile prend quelques
/// secondes pendant lesquelles la vente existe sans etre reglee, et les
/// medicaments ne se remettent pas avant.
///
/// Tout ce qui compte de l'argent filtre deja sur PAYEE — la consommation de
/// l'assureur, le chiffre d'affaires du jour — et ignore donc correctement une
/// vente en attente.
enum StatutVente {
  EN_ATTENTE
  PAYEE
  ANNULEE
}

enum StatutSessionCaisse {
  OUVERTE
  CLOTUREE
}

/// Ce que le catalogue peut contenir, en liste fermee (decision du 2026-10-01).
///
/// `Medicament.categorie` etait un texte libre facultatif : « cosmetique »,
/// « Cosmetique » et « cosmetiques » faisaient trois categories, et on ne fonde
/// pas une exclusion d'assurance sur cela. La classe therapeutique, elle, reste
/// en texte libre sous `classeTherapeutique` : c'est un autre axe.
///
/// Seul MEDICAMENT se prescrit et passe les controles d'allergie et
/// d'interaction. Les autres s'achetent au comptoir.
enum CategorieProduit {
  MEDICAMENT
  LAIT_INFANTILE
  COMPLEMENT_ALIMENTAIRE
  COSMETIQUE
  HYGIENE
  PARAPHARMACIE
  DISPOSITIF_MEDICAL
  AUTRE
}

enum ModePaiement {
  ESPECES
