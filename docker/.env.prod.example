# Gabarit des secrets de PRODUCTION (docker/docker-compose.prod.yml).
#
# Copiez-le en docker/.env.prod — ignore par git — et remplissez chaque ligne.
# **N'ecrivez jamais de vraie valeur dans ce fichier-ci** : il est suivi, et le
# depot est public. Toute variable obligatoire laissee vide fait refuser le
# demarrage par `docker compose`.
#
# Generer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Base de donnees ──────────────────────────────────────────────
POSTGRES_DB=keneya
POSTGRES_USER=keneya
POSTGRES_PASSWORD=
# Port de Postgres sur 127.0.0.1 du serveur (tunnel SSH pour les migrations).
POSTGRES_PORT_LOCAL=5432

# ─── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Jetons et chiffrement ────────────────────────────────────────
# Deux secrets distincts, 64 caracteres ou plus.
JWT_SECRET=
JWT_REFRESH_SECRET=
# 64 caracteres hexadecimaux. **Identique partout ou la meme base est lue** :
# une autre cle rend illisibles les champs deja chiffres.
DB_ENCRYPTION_KEY=

# ─── Adresses publiques (HTTPS) ───────────────────────────────────
ALLOWED_ORIGINS=https://
FRONTEND_URL=https://
WEB_PORT=8080

# ─── Courriel : indispensable, il porte les codes OTP des professionnels ──
# Sans expediteur, l'API refuse la connexion plutot que de reveler le code a
# l'ecran : plus personne ne se connecte. Les deux lignes suivantes sont donc
# obligatoires.
#
# La cle se cree dans Brevo, rubrique des cles d'API. L'API HTTP sort sur le
# port 443, que les hebergeurs laissent ouvert, contrairement aux ports SMTP.
BREVO_API_KEY=
# Une adresse **validee chez Brevo**, sur un domaine authentifie (SPF, DKIM) :
# Brevo refuse d'expedier depuis une adresse qu'il ne connait pas, et un
# domaine non authentifie envoie les codes dans les indesirables.
EMAIL_EXPEDITEUR=
# Ou arrivent les reponses. Utile quand le domaine qui expedie n'a pas de
# boite aux lettres (aucun enregistrement MX) : sans cela, une reponse se
# perd sans rebond. Facultatif.
EMAIL_REPONSE=

# ─── Courriel : replis facultatifs ────────────────────────────────
# Utilises seulement si BREVO_API_KEY est absente, dans cet ordre.
# Pour le relais SMTP de Brevo : hote smtp-relay.brevo.com, et une **cle SMTP
# dediee** comme mot de passe, qui n'est pas la cle d'API ci-dessus.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Gmail : un mot de passe d'application de 16 caracteres. A reserver au
# developpement — quotas bas, et le compte se verrouille au moindre doute.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Facultatif ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
USSD_HMAC_KEY=
USSD_ALLOWED_IPS=
CHAPCHAP_API_KEY=
CHAPCHAP_HMAC_KEY=
CHAPCHAP_CALLBACK_URL=
